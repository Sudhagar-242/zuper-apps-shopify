<style>
  .template-404 .title + * {
    margin-top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .template-404 .title + * {
      margin-top: 2rem;
    }
  }

  .error-primary-container {
    height: calc(100vh - 155px);
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
    background-color: #fff;
    overflow: hidden;
  }

  .error-primary-container img{
    position: absolute;
    top: 0;
  }

  {% comment %} .error-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: url("{{ '404-error-bg.svg' | asset_url }}") no-repeat center;
    background-size: contain; /* or 'cover' if preferred */
    opacity: 0.2;
    z-index: 0;
  } {% endcomment %}

  .error-sec-container {
    position: relative;
    max-width: 477px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .error-sec-container div{
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .error-sec-container h1 {
    font-size: 100px;
    margin: 0;
    font-weight: bold;
    margin: 0;
  }

  .error-sec-container h2 {
    font-size: 28px;
    margin: 0;
  }

  .error-sec-container p {
    font-size: 16px;
    color: #555;
    margin: 0;
  }

  .error-sec-container .btn {
    display: inline-block;
    margin: auto;
    background: #000;
    color: #fff;
    border: none;
    padding: 12px 24px;
    border-radius: 25px;
    font-size: 16px;
    cursor: pointer;
    text-decoration: none;
  }
</style>

<section class="error-primary-container">
  {% comment %} <div class="error-background"></div> {% endcomment %}
  <img src="{{ '404-error-bg.svg' | asset_url }}" alt="error Image" height="" width="" />
  <div class="error-sec-container template-404">
    <h1>{{ 'templates.404.subtext' | t }}</h1>
    <div>
      <h2>{{ 'templates.404.subtext' | t }} – {{ 'templates.404.title' | t }}</h2>
      <p>This destination doesn’t exist, but we can help you find the perfect stay!</p>
    </div>
    <a href="{{ routes.root_url }}" class="btn">Go Back Home</a>
  </div>
</section>
