<style>
  .template-404 .title + * {
    margin-top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .template-404 .title + * {
      margin-top: 2rem;
    }
  }

  .error-404-section{
    
  }

  .error-primary-container {
    height: calc(100vh - 155px);
    margin: 0 auto;
    max-width: 1440px;
    padding: 0;
    font-family: Arial, sans-serif;
    background: url("{{ '404-error-bg.svg' | asset_url }}") no-repeat center;
    background-size: cover; /* or cover if you prefer */
    background-color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
  }

  .error-sec-container {
    position: relative;
    max-width: 477px;
    display: flex;
    flex-direction: column;
    z-index: 1;
  }

  .error-sec-container h1 {
    font-size: 100px;
    margin: 0;
    font-weight: bold;
  }

  .error-sec-container h2 {
    font-size: 28px;
    margin: 10px 0;
  }

  .error-sec-container p {
    font-size: 16px;
    color: #555;
    margin-bottom: 20px;
  }

  .error-sec-container .btn {
    background: #000;
    color: #fff;
    border: none;
    padding: 12px 24px;
    border-radius: 25px;
    font-size: 16px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    margin: auto;
  }
</style>

<section class="error-primary-container">
  <div class="error-sec-container template-404">
    <h1>{{ 'templates.404.subtext' | t }}</h1>
    <div>
      <h2 class="title">{{ 'templates.404.subtext' | t }} – {{ 'templates.404.title' | t }}</h2>
      <p>This destination doesn’t exist, but we can help you find the perfect stay!</p>
    </div>
    <a href="{{ routes.root_url }}" class="btn">Go Back Home</a>
  </div>
</section>


{% schema %}
{
  "name": "main404",
  "tag": "section",
  "class": "error-404-section"
}
{% endschema %}